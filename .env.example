# Copy to .env and adjust. Never commit .env (it is git-ignored).
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=observatorio

KAFKA_TOPIC=earthquakes-live
KAFKA_REPLAY_TOPIC=earthquakes-replay
USGS_POLL_INTERVAL_SECONDS=60

# Exact browser origins allowed by the API (comma separated, no wildcard).
# Add your Netlify origin, e.g. http://localhost:4200,https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Only for `docker compose --profile tunnel up -d` (leave empty otherwise).
# Get the token from your ngrok dashboard and put it ONLY in your local .env.
NGROK_AUTHTOKEN=
# Optional reserved domain, e.g. https://my-name.ngrok-free.app
NGROK_URL=
